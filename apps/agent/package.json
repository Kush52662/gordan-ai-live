{
  "name": "@gordon-ai/agent",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{ts,js}\"",
    "lint:fix": "eslint --fix \"**/*.{ts,js}\"",
    "format": "prettier --write \"**/*.{ts,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md}\"",
    "test": "vitest --run",
    "test:watch": "vitest",
    "dev": "node src/main.ts dev",
    "start": "node src/main.ts start",
    "console": "node src/main.ts console"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@trivago/prettier-plugin-sort-imports": "^5.2.2",
    "@types/node": "^24.13.5",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jiti": "^2.7.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@livekit/agents": "^1.9.3",
    "@livekit/agents-plugin-google": "^1.9.2",
    "@livekit/rtc-node": "^1.1.0",
    "dotenv": "^17.4.2",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "packageManager": "pnpm@10.28.1",
  "pnpm": {
    "patchedDependencies": {
      "@livekit/agents@1.9.3": "patches/@livekit__agents@1.9.3.patch",
      "@livekit/agents-plugin-google@1.9.3": "patches/@livekit__agents-plugin-google@1.9.3.patch"
    }
  }
}
